# Variables de entorno requeridas por el backend (ver application.properties).

# --- Base de datos (PostgreSQL) ---
DB_LINK=jdbc:postgresql://localhost:5432/nombre_base_datos
DB_USERNAME=postgres
DB_PASSWORD=

# --- Empleado administrador inicial (ver DatosInicialesSeeder) ---
ADMIN_CEDULA=
ADMIN_CORREO=

# --- Microsoft Graph ---
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Buzon (mailbox) desde el que se envia el correo (debe existir en el tenant).
MS_GRAPH_SENDER_EMAIL=

# --- Frontend ---
# Origen del frontend
FRONTEND_URL=http://localhost:5173
