# Variables de entorno requeridas por el backend (ver application.properties).

# --- Base de datos (PostgreSQL) ---
DB_LINK=jdbc:postgresql://localhost:5432/nombre_base_datos
DB_USERNAME=postgres
DB_PASSWORD=

# --- Empleado administrador inicial (ver DatosInicialesSeeder) ---
ADMIN_CEDULA=
ADMIN_CORREO=

# --- Mailtrap (correo de recuperacion de contrasena) ---
# Token de la API de Mailtrap (ver "API Tokens" en el dashboard de Mailtrap).
MAILTRAP_API_TOKEN=
# Remitente que vera el usuario al recibir el correo.
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=Sistema de Inventario Coopcentro
# true = Email Sandbox (pruebas, no requiere dominio verificado, no entrega
# correos reales). false = envio real via Sending API (requiere dominio propio
# verificado en Mailtrap).
MAILTRAP_SANDBOX=true
# Id numerico de la inbox de pruebas de Mailtrap (obligatorio si MAILTRAP_SANDBOX=true).
MAILTRAP_INBOX_ID=

# --- Frontend ---
# Origen del frontend
FRONTEND_URL=http://localhost:5173
